# PayPal sandbox app keys: developer.paypal.com > Apps & Credentials > Sandbox > Create App
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
# sandbox | live | mock  (mock = offline simulation, no keys needed)
PAYPAL_MODE=sandbox
# Where PayPal sends the buyer back after approving. Your Render URL once deployed.
APP_URL=http://localhost:8000
# Optional: PayPal webhook ID (sandbox app > Webhooks) so signed events can reconcile payments
PAYPAL_WEBHOOK_ID=

GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=your_google_key
